{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "trailingSlash": true,
  "rewrites": [
    {
      "source": "/api/feedback/:id",
      "destination": "/api/feedback?id=:id"
    },
    {
      "source": "/api/shopping-shares/:id",
      "destination": "/api/shopping-shares?id=:id"
    }
  ],
  "headers": [
    {
      "source": "/images/products-optimized/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/catalog/(.*)\\.json",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
